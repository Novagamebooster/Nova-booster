<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NOVA</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@900&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --bg: #030509;
      --card: rgba(255,255,255,.04);
      --line: rgba(255,255,255,.08);
      --text: #ffffff;
      --muted: #8b93a7;
      --cyan: #00c8ff;
      --purple: #a855f7;
      --teal: #00ffd1;
      --blue: #3b82f6;
      --success: #34d399;
      --warning: #fbbf24;
      --danger: #fb7185;
    }

    body[data-theme="white"] {
      --bg: #f4f7ff;
      --card: rgba(255,255,255,.75);
      --line: rgba(15,23,42,.08);
      --text: #0f172a;
      --muted: #64748b;
    }

    body {
      font-family: "Segoe UI", Tahoma, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
      transition: background .3s, color .3s;
    }

    .bgAnimated {
      position: fixed;
      inset: 0;
      z-index: -2;
      background:
        radial-gradient(circle at 15% 15%, rgba(0,200,255,.18), transparent 30%),
        radial-gradient(circle at 85% 25%, rgba(168,85,247,.18), transparent 30%),
        radial-gradient(circle at 50% 80%, rgba(0,255,209,.14), transparent 30%),
        radial-gradient(circle at 70% 60%, rgba(59,130,246,.12), transparent 25%),
        var(--bg);
      animation: bgPulse 12s ease-in-out infinite alternate;
    }

    body[data-theme="white"] .bgAnimated {
      background:
        radial-gradient(circle at 15% 15%, rgba(0,200,255,.10), transparent 30%),
        radial-gradient(circle at 85% 25%, rgba(168,85,247,.10), transparent 30%),
        radial-gradient(circle at 50% 80%, rgba(0,255,209,.08), transparent 30%),
        #f4f7ff;
    }

    @keyframes bgPulse {
      0% { opacity: .8; }
      100% { opacity: 1; }
    }

    .lines {
      position: fixed;
      inset: 0;
      z-index: -1;
      background-image: repeating-linear-gradient(
        45deg,
        rgba(255,255,255,.02) 0px,
        rgba(255,255,255,.02) 1px,
        transparent 1px,
        transparent 12px
      );
      pointer-events: none;
    }

    body[data-theme="white"] .lines {
      background-image: repeating-linear-gradient(
        45deg,
        rgba(15,23,42,.03) 0px,
        rgba(15,23,42,.03) 1px,
        transparent 1px,
        transparent 12px
      );
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 24px 20px 12px;
      max-width: 560px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .logo {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-family: 'Orbitron', 'Segoe UI', sans-serif;
      font-weight: 900;
      font-size: 26px;
      color: white;
      background: conic-gradient(from 210deg, var(--cyan), var(--purple), var(--teal), var(--blue), var(--cyan));
      box-shadow: 0 0 30px rgba(0,200,255,.4), inset 0 0 15px rgba(255,255,255,.15);
      position: relative;
    }

    .logo::before {
      content: "";
      position: absolute;
      inset: 3px;
      border-radius: 50%;
      background: var(--bg);
      z-index: 0;
    }

    body[data-theme="white"] .logo::before {
      background: #fff;
    }

    .logo span {
      position: relative;
      z-index: 1;
      background: linear-gradient(135deg, var(--cyan), var(--purple), var(--teal));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .logo::after {
      content: "";
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid transparent;
      border-top-color: var(--cyan);
      border-bottom-color: var(--purple);
      animation: spinRing 2.5s linear infinite;
    }

    @keyframes spinRing {
      to { transform: rotate(360deg); }
    }

    .brand h1 {
      font-family: 'Orbitron', 'Segoe UI', sans-serif;
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 6px;
      text-transform: uppercase;
      background: linear-gradient(135deg, var(--cyan), var(--purple), var(--teal), var(--blue));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .brand p {
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-top: 4px;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--success);
      white-space: nowrap;
    }

    .status::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 12px currentColor;
      animation: pulse 2s infinite;
    }

    .status.offline {
      color: var(--danger);
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .4; transform: scale(1.2); }
    }

    main {
      padding: 10px 20px 120px;
      max-width: 560px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
      animation: fadeUp .3s ease;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 24px;
      padding: 20px;
      box-shadow: 0 18px 50px rgba(0,0,0,.25);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      margin-bottom: 16px;
      position: relative;
      overflow: hidden;
    }

    .boost-card {
      text-align: center;
      padding: 18px 16px;
    }

    .boost-title {
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .selected-game {
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 1px;
      direction: ltr;
      margin-bottom: 8px;
    }

    .boost-ring {
      width: 200px;
      height: 200px;
      margin: 12px auto;
      position: relative;
    }

    .pulse-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px solid;
      opacity: 0;
      pointer-events: none;
    }

    .pr1 { border-color: var(--cyan); }
    .pr2 { border-color: var(--purple); }
    .pr3 { border-color: var(--teal); }

    .scanning .pr1 { animation: pulseRing 2.2s infinite; }
    .scanning .pr2 { animation: pulseRing 2.2s .6s infinite; }
    .scanning .pr3 { animation: pulseRing 2.2s 1.2s infinite; }

    @keyframes pulseRing {
      0% { transform: scale(.8); opacity: .7; }
      100% { transform: scale(1.3); opacity: 0; }
    }

    .ring-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
      position: absolute;
      inset: 0;
      z-index: 4;
    }

    .ring-bg {
      fill: none;
      stroke: var(--line);
      stroke-width: 4;
    }

    .ring-progress {
      fill: none;
      stroke: url(#novaGrad);
      stroke-width: 6;
      stroke-linecap: round;
      stroke-dasharray: 628;
      stroke-dashoffset: 628;
      transition: stroke-dashoffset .18s linear;
      filter: drop-shadow(0 0 8px var(--cyan));
    }

    .radar-layer {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      z-index: 1;
    }

    .radar-glow {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: radial-gradient(circle at center, rgba(0,200,255,.12) 0%, transparent 45%);
      pointer-events: none;
    }

    .holo-lines {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 3px,
        rgba(0,200,255,.03) 3px,
        rgba(0,200,255,.03) 4px
      );
      pointer-events: none;
      mask: radial-gradient(circle, black 0%, black 86%, transparent 87%);
      -webkit-mask: radial-gradient(circle, black 0%, black 86%, transparent 87%);
    }

    .scan-cone {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: conic-gradient(from 0deg,
        transparent 0deg,
        rgba(0,200,255,0) 300deg,
        rgba(0,200,255,.06) 330deg,
        rgba(0,200,255,.25) 352deg,
        rgba(255,255,255,.55) 359deg,
        rgba(255,255,255,.8) 360deg
      );
      opacity: 0;
      transition: opacity .4s;
      mask: radial-gradient(circle, black 0%, black 86%, transparent 87%);
      -webkit-mask: radial-gradient(circle, black 0%, black 86%, transparent 87%);
      animation: radarScan 2.8s linear infinite;
      pointer-events: none;
      z-index: 2;
    }

    .scanning .scan-cone {
      opacity: 1;
    }

    @keyframes radarScan {
      to { transform: rotate(360deg); }
    }

    .radar-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 3;
    }

    .radar-ring {
      fill: none;
      stroke-width: 1;
      opacity: .6;
    }

    .r1 { stroke: rgba(0,200,255,.30); stroke-dasharray: 2 4; }
    .r2 { stroke: rgba(168,85,247,.25); stroke-dasharray: 4 6; }
    .r3 { stroke: rgba(0,255,209,.22); stroke-dasharray: 1 3; }
    .r4 { stroke: rgba(59,130,246,.28); }

    .radar-spoke {
      stroke: rgba(0,200,255,.10);
      stroke-width: 1;
    }

    .radar-wave {
      fill: none;
      stroke: rgba(0,200,255,.35);
      stroke-width: 1;
      transform-origin: 110px 110px;
      opacity: 0;
      animation: waveExpand 3.6s linear infinite;
    }

    .w2 { animation-delay: 1.2s; }
    .w3 { animation-delay: 2.4s; }

    @keyframes waveExpand {
      0% { transform: scale(.08); opacity: .9; stroke-width: 2; }
      100% { transform: scale(1); opacity: 0; stroke-width: .5; }
    }

    .radar-particles {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      pointer-events: none;
      overflow: hidden;
      z-index: 2;
    }

    .radar-particle {
      position: absolute;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--cyan);
      opacity: .3;
      animation: particleFloat 4s infinite alternate ease-in-out;
    }

    @keyframes particleFloat {
      from { transform: translate(0, 0); opacity: .15; }
      to { transform: translate(6px, -8px); opacity: .55; }
    }

    .dot-halo {
      opacity: .18;
      filter: blur(3px);
      transition: all .4s;
    }

    .server-dot {
      transition: all .4s;
    }

    .server-dot.auto {
      fill: var(--cyan);
      filter: drop-shadow(0 0 4px var(--cyan));
    }

    .dot-halo.auto { fill: var(--cyan); }

    .server-dot.best {
      fill: var(--success);
      filter: drop-shadow(0 0 6px var(--success));
    }

    .dot-halo.best {
      fill: var(--success);
      opacity: .25;
    }

    .server-dot.scanning-dot {
      animation: dotPulse 1s infinite;
    }

    @keyframes dotPulse {
      0%, 100% { opacity: .4; }
      50% { opacity: 1; }
    }

    .core {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 76px;
      height: 76px;
      border-radius: 50%;
      background: rgba(255,255,255,.05);
      border: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 5;
      box-shadow: inset 0 0 20px rgba(0,200,255,.06), 0 0 20px rgba(0,200,255,.10);
    }

    .ping-value {
      display: flex;
      align-items: baseline;
      gap: 2px;
      font-size: 26px;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      background: linear-gradient(135deg, var(--cyan), var(--purple), var(--teal));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .ping-unit {
      font-size: 10px;
      color: var(--muted);
      font-weight: 700;
    }

    .server-label {
      margin-top: 8px;
      font-size: 10px;
      color: var(--muted);
      letter-spacing: 1px;
      text-transform: uppercase;
      direction: ltr;
      min-height: 14px;
    }

    .metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 12px;
    }

    .metric {
      padding: 10px 6px;
      border-radius: 14px;
      background: rgba(255,255,255,.03);
      border: 1px solid var(--line);
    }

    .metric b {
      display: block;
      font-size: 14px;
      margin-bottom: 3px;
      font-variant-numeric: tabular-nums;
    }

    .metric span {
      font-size: 9px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn-boost {
      width: 100%;
      padding: 14px;
      border-radius: 18px;
      border: none;
      background: linear-gradient(135deg, var(--cyan), var(--purple), var(--teal));
      color: white;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 12px 30px rgba(124,58,237,.3);
      margin-top: 14px;
      transition: .2s;
      position: relative;
      overflow: hidden;
    }

    .btn-boost:active {
      transform: scale(.98);
    }

    .btn-sub {
      display: block;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 1px;
      margin-top: 3px;
      opacity: .8;
      text-transform: none;
    }

    .section-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 20px 0 10px;
    }

    .section-title h2 {
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--text);
    }

    .section-title span {
      font-size: 10px;
      color: var(--muted);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .history {
      display: flex;
      align-items: flex-end;
      gap: 5px;
      height: 50px;
      margin-top: 8px;
      padding: 8px;
      border-radius: 14px;
      background: rgba(255,255,255,.03);
      border: 1px solid var(--line);
      overflow: hidden;
    }

    .bar {
      flex: 1;
      background: linear-gradient(180deg, var(--cyan), var(--purple));
      border-radius: 6px 6px 0 0;
      min-height: 4px;
      transition: .3s;
      box-shadow: 0 0 8px rgba(0,200,255,.2);
    }

    .game-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .game-card {
      padding: 12px;
      border-radius: 18px;
      background: var(--card);
      border: 1px solid var(--line);
      cursor: pointer;
      transition: .2s;
      text-align: center;
    }

    .game-card:active {
      transform: scale(.97);
    }

    .game-card.selected {
      border-color: var(--cyan);
      background: rgba(0,200,255,.06);
    }

    .game-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      font-weight: 900;
      font-size: 14px;
      color: #081018;
      margin: 0 auto 8px;
      overflow: hidden;
      background: linear-gradient(135deg, #1a1a2e, #16213e);
      position: relative;
      box-shadow: 0 4px 12px rgba(0,0,0,.3);
    }

    .game-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 14px;
      position: absolute;
      inset: 0;
      z-index: 2;
    }

    .game-icon .fallback-text {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-weight: 900;
      font-size: 16px;
      color: white;
      z-index: 1;
      text-shadow: 0 2px 8px rgba(0,0,0,.5);
    }

    .game-name {
      font-size: 11px;
      font-weight: 800;
      direction: ltr;
      text-align: center;
      line-height: 1.4;
      margin-top: 8px;
    }

    .game-genre {
      font-size: 9px;
      color: var(--muted);
      direction: ltr;
      text-align: center;
      margin-top: 3px;
    }

    .btn-more {
      width: 100%;
      padding: 10px;
      border-radius: 16px;
      border: 1px dashed var(--line);
      background: transparent;
      color: var(--muted);
      font-size: 18px;
      cursor: pointer;
      margin-top: 8px;
      transition: .2s;
    }

    .btn-more:active {
      transform: scale(.98);
    }

    .server-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
    }

    .server-tab {
      flex: 1;
      padding: 10px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--muted);
      font-weight: 800;
      font-size: 13px;
      cursor: pointer;
      transition: .2s;
    }

    .server-tab.active {
      background: linear-gradient(135deg, rgba(0,200,255,.15), rgba(168,85,247,.15));
      color: var(--text);
      border-color: var(--cyan);
    }

    .server-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      border-radius: 16px;
      background: var(--card);
      border: 1px solid var(--line);
      margin-bottom: 8px;
      transition: .2s;
    }

    .server-row:active {
      transform: scale(.98);
    }

    .server-row.best {
      border-color: var(--success);
      background: rgba(52,211,153,.06);
    }

    .server-row.manual-selected {
      border-color: var(--purple);
      background: rgba(168,85,247,.08);
      box-shadow: 0 0 12px rgba(168,85,247,.15);
    }

    .server-name {
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 4px;
    }

    .server-host {
      direction: ltr;
      text-align: right;
      color: var(--muted);
      font-size: 11px;
    }

    .ping-badge {
      min-width: 66px;
      text-align: center;
      padding: 8px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 900;
      border: 1px solid var(--line);
      color: var(--muted);
      font-variant-numeric: tabular-nums;
    }

    .good {
      color: #a7f3d0;
      background: rgba(52,211,153,.12);
      border-color: rgba(52,211,153,.18);
    }

    .mid {
      color: #fde68a;
      background: rgba(251,191,36,.12);
      border-color: rgba(251,191,36,.18);
    }

    .bad {
      color: #fecdd3;
      background: rgba(251,113,133,.12);
      border-color: rgba(251,113,133,.18);
    }

    .input, select {
      width: 100%;
      padding: 13px 14px;
      border-radius: 16px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.04);
      color: var(--text);
      outline: none;
      margin-bottom: 12px;
    }

    body[data-theme="white"] .input,
    body[data-theme="white"] select {
      background: rgba(255,255,255,.8);
    }

    .label {
      color: var(--muted);
      font-size: 12px;
      margin: 12px 0 7px;
      display: block;
    }

    .plans {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 12px;
    }

    .plan {
      padding: 14px;
      border-radius: 20px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.03);
      cursor: pointer;
      transition: .2s;
      text-align: center;
    }

    .plan.active {
      border-color: var(--cyan);
      box-shadow: 0 0 18px rgba(0,200,255,.12);
    }

    .plan b {
      display: block;
      margin-bottom: 4px;
      font-size: 14px;
      letter-spacing: 1px;
    }

    .plan span {
      color: var(--muted);
      font-size: 11px;
    }

    .settings-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 13px 0;
      border-bottom: 1px solid var(--line);
      position: relative;
    }

    .settings-row:last-child {
      border-bottom: 0;
    }

    .switch {
      width: 48px;
      height: 27px;
      border-radius: 999px;
      position: relative;
      background: rgba(255,255,255,.12);
      appearance: none;
      cursor: pointer;
      outline: none;
      border: 1px solid var(--line);
      flex-shrink: 0;
    }

    .switch:checked {
      background: linear-gradient(135deg, var(--cyan), var(--purple));
    }

    .switch::after {
      content: "";
      position: absolute;
      top: 2px;
      left: 2px;
      width: 21px;
      height: 21px;
      border-radius: 50%;
      background: white;
      transition: .2s;
    }

    .switch:checked::after {
      transform: translateX(21px);
    }

    .bottom-nav {
      position: fixed;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 32px);
      max-width: 560px;
      display: flex;
      gap: 8px;
      padding: 8px;
      border-radius: 24px;
      background: rgba(3,5,9,.8);
      border: 1px solid var(--line);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 18px 40px rgba(0,0,0,.35);
      z-index: 20;
    }

    body[data-theme="white"] .bottom-nav {
      background: rgba(255,255,255,.8);
    }

    .nav-btn {
      flex: 1;
      padding: 12px;
      border: none;
      background: transparent;
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-radius: 16px;
      cursor: pointer;
      transition: .2s;
    }

    .nav-btn.active {
      background: linear-gradient(135deg, rgba(0,200,255,.15), rgba(168,85,247,.15));
      color: var(--text);
    }

    #toast {
      position: fixed;
      bottom: 100px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--card);
      color: var(--text);
      border: 1px solid var(--line);
      padding: 12px 18px;
      border-radius: 18px;
      opacity: 0;
      pointer-events: none;
      transition: .3s;
      z-index: 50;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      max-width: calc(100vw - 30px);
      text-align: center;
      font-size: 13px;
      letter-spacing: .5px;
    }

    #toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .muted {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.9;
    }

    .btn-full {
      width: 100%;
      padding: 15px;
      border-radius: 18px;
      border: none;
      background: linear-gradient(135deg, var(--cyan), var(--purple));
      color: white;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      margin-top: 12px;
    }

    .btn-full:active {
      transform: scale(.98);
    }

    .btn-full.ghost {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--text);
    }

    .theme-btns {
      display: flex;
      gap: 8px;
    }

    .theme-btn {
      padding: 9px 12px;
      font-size: 11px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 700;
    }

    .theme-btn.active {
      border-color: var(--cyan);
      color: var(--text);
      background: rgba(0,200,255,.08);
    }
  </style>
</head>
<body data-theme="neon">

  <div class="bgAnimated"></div>
  <div class="lines"></div>

  <header class="topbar">
    <div class="brand">
      <div class="logo"><span>N</span></div>
      <div>
        <h1>NOVA</h1>
        <p>Game Booster</p>
      </div>
    </div>
    <div class="status" id="netStatus">ONLINE</div>
  </header>

  <main>

    <!-- HOME -->
    <section id="home" class="page active">
      <div class="card boost-card" id="boostCard">
        <div class="boost-title">BOOST CORE</div>
        <div class="selected-game" id="selectedGameName">NO GAME SELECTED</div>

        <div class="boost-ring" id="boostRing">
          <div class="pulse-ring pr1"></div>
          <div class="pulse-ring pr2"></div>
          <div class="pulse-ring pr3"></div>

          <svg class="ring-svg" viewBox="0 0 220 220">
            <defs>
              <linearGradient id="novaGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#00c8ff"/>
                <stop offset="35%" stop-color="#3b82f6"/>
                <stop offset="70%" stop-color="#a855f7"/>
                <stop offset="100%" stop-color="#00ffd1"/>
              </linearGradient>
            </defs>
            <circle class="ring-bg" cx="110" cy="110" r="100"/>
            <circle class="ring-progress" id="ringProgress" cx="110" cy="110" r="100"/>
          </svg>

          <div class="radar-layer">
            <div class="radar-glow"></div>
            <div class="holo-lines"></div>
            <div class="scan-cone"></div>

            <svg class="radar-svg" viewBox="0 0 220 220">
              <circle class="radar-ring r1" cx="110" cy="110" r="30"/>
              <circle class="radar-ring r2" cx="110" cy="110" r="50"/>
              <circle class="radar-ring r3" cx="110" cy="110" r="70"/>
              <circle class="radar-ring r4" cx="110" cy="110" r="90"/>

              <line class="radar-spoke" x1="110" y1="110" x2="110" y2="20"/>
              <line class="radar-spoke" x1="110" y1="110" x2="177" y2="43"/>
              <line class="radar-spoke" x1="110" y1="110" x2="205" y2="110"/>
              <line class="radar-spoke" x1="110" y1="110" x2="177" y2="177"/>
              <line class="radar-spoke" x1="110" y1="110" x2="110" y2="205"/>
              <line class="radar-spoke" x1="110" y1="110" x2="43" y2="177"/>
              <line class="radar-spoke" x1="110" y1="110" x2="15" y2="110"/>
              <line class="radar-spoke" x1="110" y1="110" x2="43" y2="43"/>

              <circle class="radar-wave w1" cx="110" cy="110" r="95"/>
              <circle class="radar-wave w2" cx="110" cy="110" r="95"/>
              <circle class="radar-wave w3" cx="110" cy="110" r="95"/>

              <g id="serverDots"></g>
            </svg>

            <div class="radar-particles" id="radarParticles"></div>
          </div>

          <div class="core">
            <div class="ping-value">
              <span id="pingValue">--</span>
              <span class="ping-unit" id="pingUnit" style="display:none;">ms</span>
            </div>
          </div>
        </div>

        <div class="server-label" id="serverValue">SELECT A SERVER</div>

        <div class="metrics">
          <div class="metric"><b id="jitter">--</b><span>JITTER</span></div>
          <div class="metric"><b id="loss">--</b><span>LOSS</span></div>
          <div class="metric"><b id="route">--</b><span>ROUTE</span></div>
        </div>

        <div class="section-title" style="margin-top:14px;">
          <h2>PING HISTORY</h2>
          <span>LAST 10</span>
        </div>

        <div id="pingHistory" class="history"></div>

        <button id="boostBtn" class="btn-boost">
          START BOOST
          <span class="btn-sub">شروع بوست</span>
        </button>
      </div>

      <div class="section-title">
        <h2>GAMES</h2>
        <span>TAP TO SELECT</span>
      </div>

      <div id="gamesGrid" class="game-grid"></div>
      <button id="moreGamesBtn" class="btn-more">⌄</button>

      <div class="section-title">
        <h2>SERVERS</h2>
        <span>AUTO + MANUAL</span>
      </div>

      <div class="server-tabs">
        <button class="server-tab active" onclick="switchServerTab('auto', this)">اتوماتیک</button>
        <button class="server-tab" onclick="switchServerTab('manual', this)">دستی</button>
      </div>

      <div id="serverList"></div>

      <button id="refreshServers" class="btn-full">REFRESH SERVERS</button>
    </section>

    <!-- PROFILE -->
    <section id="profile" class="page">
      <div class="card">
        <div class="section-title" style="margin-top:0;">
          <h2>PROFILE</h2>
          <span>DEMO</span>
        </div>

        <label class="label">USERNAME</label>
        <input id="username" class="input" placeholder="e.g. NovaPro">

        <label class="label">PHONE</label>
        <input id="mobile" class="input" placeholder="09xxxxxxxxx">

        <label class="label">EMAIL</label>
        <input id="email" class="input" placeholder="example@gmail.com">

        <button id="saveProfile" class="btn-full">SAVE PROFILE</button>
      </div>

      <div class="card">
        <div class="section-title" style="margin-top:0;">
          <h2>PREMIUM</h2>
        </div>

        <div class="plans">
          <div class="plan"><b>1 MONTH</b><span>یک ماهه</span></div>
          <div class="plan"><b>3 MONTHS</b><span>سه ماهه</span></div>
          <div class="plan"><b>6 MONTHS</b><span>شش ماهه</span></div>
          <div class="plan"><b>12 MONTHS</b><span>دوازده ماهه</span></div>
        </div>

        <button id="buyBtn" class="btn-full" style="margin-top:14px;">خرید اشتراک</button>
      </div>
    </section>

    <!-- SETTINGS -->
    <section id="settings" class="page">
      <div class="card">
        <div class="section-title" style="margin-top:0;">
          <h2>تنظیمات</h2>
          <span>اپ</span>
        </div>

        <div class="settings-row">
          <span>تم اپ</span>
          <div class="theme-btns">
            <button class="theme-btn active" data-theme="neon">نئون ترکیبی</button>
            <button class="theme-btn" data-theme="white">روشن</button>
          </div>
        </div>

        <div class="settings-row">
          <span>اعلان بروزرسانی</span>
          <input type="checkbox" id="notifySwitch" class="switch">
        </div>

        <div class="settings-row">
          <span>پشتیبانی</span>
          <b>support@nova.local</b>
        </div>

        <div class="settings-row">
          <span>نسخه</span>
          <b>3.3.0</b>
        </div>
      </div>

      <div class="card">
        <p class="muted">
          نوا — رادار هولوگرافیک، طراحی مینیمال، بدون صدا.
        </p>
      </div>
    </section>

  </main>

  <nav class="bottom-nav">
    <button class="nav-btn active" onclick="showPage('home', this)">HOME</button>
    <button class="nav-btn" onclick="showPage('profile', this)">PROFILE</button>
    <button class="nav-btn" onclick="showPage('settings', this)">SETTINGS</button>
  </nav>

  <div id="toast"></div>

  <script>
    const games = [
      { 
        id: "mlbb", 
        name: "Mobile Legends: Bang Bang", 
        short: "MLBB", 
        mode: "MOBA", 
        c1: "#ffb300", 
        c2: "#ff6f00",
        icons: [
          "https://upload.wikimedia.org/wikipedia/en/8/8f/Mobile_Legends_Bang_Bang_Logo.png",
          "https://cdn2.steamgriddb.com/logo/5c8f8f8f8f8f8f8f8f8f8f8f.png",
          "https://via.placeholder.com/100/ffb300/ffffff?text=MLBB"
        ]
      },
      { 
        id: "codm", 
        name: "Call of Duty: Mobile", 
        short: "CODM", 
        mode: "FPS", 
        c1: "#22d3ee", 
        c2: "#2563eb",
        icons: [
          "https://upload.wikimedia.org/wikipedia/en/0/0d/Call_of_Duty_Mobile_logo.png",
          "https://cdn2.steamgriddb.com/logo/6d9g9g9g9g9g9g9g9g9g9g9g.png",
          "https://via.placeholder.com/100/2563eb/ffffff?text=COD"
        ]
      },
      { 
        id: "df", 
        name: "Delta Force", 
        short: "DF", 
        mode: "Tactical FPS", 
        c1: "#94a3b8", 
        c2: "#475569",
        icons: [
          "https://upload.wikimedia.org/wikipedia/en/5/5d/Delta_Force_logo.png",
          "https://via.placeholder.com/100/475569/ffffff?text=DF"
        ]
      },
      { 
        id: "pubg", 
        name: "PUBG Mobile", 
        short: "PUBG", 
        mode: "Battle Royale", 
        c1: "#facc15", 
        c2: "#f59e0b",
        icons: [
          "https://upload.wikimedia.org/wikipedia/en/4/4a/PUBG_Mobile_logo.png",
          "https://via.placeholder.com/100/f59e0b/ffffff?text=PUBG"
        ]
      },
      { 
        id: "ff", 
        name: "Free Fire", 
        short: "FF", 
        mode: "Battle Royale", 
        c1: "#fb7185", 
        c2: "#ef4444",
        icons: [
          "https://upload.wikimedia.org/wikipedia/en/8/8c/Garena_Free_Fire_logo.png",
          "https://via.placeholder.com/100/ef4444/ffffff?text=FF"
        ]
      },
      { 
        id: "fc", 
        name: "EA SPORTS FC Mobile", 
        short: "FC", 
        mode: "Sports", 
        c1: "#34d399", 
        c2: "#059669",
        icons: [
          "https://upload.wikimedia.org/wikipedia/en/6/6a/EA_Sports_FC_Mobile_logo.png",
          "https://via.placeholder.com/100/059669/ffffff?text=FC"
        ]
      },
      { 
        id: "ef", 
        name: "eFootball", 
        short: "eF", 
        mode: "Sports", 
        c1: "#60a5fa", 
        c2: "#2563eb",
        icons: [
          "https://upload.wikimedia.org/wikipedia/en/0/0c/EFootball_logo.png",
          "https://via.placeholder.com/100/2563eb/ffffff?text=eF"
        ]
      },
      { 
        id: "hok", 
        name: "Honor of Kings", 
        short: "HOK", 
        mode: "MOBA", 
        c1: "#c084fc", 
        c2: "#7c3aed",
        icons: [
          "https://upload.wikimedia.org/wikipedia/en/7/7c/Honor_of_Kings_logo.png",
          "https://via.placeholder.com/100/7c3aed/ffffff?text=HOK"
        ]
      }
    ];

    let servers = [
      { name: "Iran - Tehran", host: "ir1.nova.gg", port: 443, auto: true, ping: null, angle: 30, dist: 40 },
      { name: "Turkey - Istanbul", host: "tr1.nova.gg", port: 443, auto: true, ping: null, angle: 320, dist: 65 },
      { name: "Germany - Frankfurt", host: "de1.nova.gg", port: 443, auto: true, ping: null, angle: 290, dist: 90 },
      { name: "UAE - Dubai", host: "ae1.nova.gg", port: 443, auto: true, ping: null, angle: 160, dist: 55 },
      { name: "Singapore - SG", host: "sg1.nova.gg", port: 443, auto: true, ping: null, angle: 110, dist: 95 }
    ];

    let showAllGames = false;
    let selectedGame = localStorage.getItem("nova_selected_game") || null;
    let pingHistory = [];
    let currentBest = null;
    let serverTab = 'auto';
    let manualSelected = localStorage.getItem("nova_manual_selected") || null;

    let boosting = false;
    let boostTimer = null;
    const circumference = 628;

    function createRadarParticles() {
      const container = document.getElementById("radarParticles");
      if (!container) return;
      const count = 14;
      container.innerHTML = "";

      for (let i = 0; i < count; i++) {
        const p = document.createElement("div");
        p.className = "radar-particle";

        const angle = Math.random() * 360;
        const dist = 15 + Math.random() * 70;
        const rad = angle * Math.PI / 180;
        const x = 50 + Math.cos(rad) * (dist / 2);
        const y = 50 + Math.sin(rad) * (dist / 2);

        p.style.left = x + "%";
        p.style.top = y + "%";
        p.style.animationDelay = (Math.random() * 3) + "s";
        p.style.animationDuration = (3 + Math.random() * 4) + "s";

        const colors = ["var(--cyan)", "var(--purple)", "var(--teal)", "var(--blue)"];
        p.style.background = colors[Math.floor(Math.random() * colors.length)];

        container.appendChild(p);
      }
    }

    function loadGameIcon(game, imgElement) {
      let currentIndex = 0;

      function showFallback() {
        imgElement.style.display = 'none';
        const existing = imgElement.parentElement.querySelector('.fallback-text');
        if (!existing) {
          const fallback = document.createElement('div');
          fallback.className = 'fallback-text';
          fallback.textContent = game.short;
          fallback.style.background = `linear-gradient(135deg, ${game.c1}, ${game.c2})`;
          imgElement.parentElement.appendChild(fallback);
        }
      }

      function tryLoad() {
        if (currentIndex >= game.icons.length) {
          showFallback();
          return;
        }

        imgElement.onerror = function() {
          currentIndex++;
          tryLoad();
        };

        imgElement.onload = function() {
          imgElement.style.display = 'block';
        };

        imgElement.src = game.icons[currentIndex];
      }

      tryLoad();
    }

    function selectGame(id) {
      selectedGame = id;
      localStorage.setItem("nova_selected_game", id);
      renderGames();
      updateSelectedGameName();
      toast("Game selected");
      refreshServers();
    }

    function updateSelectedGameName() {
      const el = document.getElementById("selectedGameName");
      const game = games.find(g => g.id === selectedGame);
      el.textContent = game ? game.name.toUpperCase() : "NO GAME SELECTED";
    }

    function renderGames() {
      const grid = document.getElementById("gamesGrid");
      const list = showAllGames ? games : games.slice(0, 4);

      grid.innerHTML = list.map(game => `
        <div class="game-card ${selectedGame === game.id ? "selected" : ""}" onclick="selectGame('${game.id}')">
          <div class="game-icon" style="background:linear-gradient(135deg, ${game.c1}, ${game.c2});">
            <img data-game-id="${game.id}" alt="${game.short}" style="display:none;">
          </div>
          <div class="game-name">${game.name}</div>
          <div class="game-genre">${game.mode}</div>
        </div>
      `).join("");

      document.querySelectorAll('.game-icon img').forEach(img => {
        const gameId = img.getAttribute('data-game-id');
        const game = games.find(g => g.id === gameId);
        if (game) loadGameIcon(game, img);
      });

      document.getElementById("moreGamesBtn").innerHTML = showAllGames ? "⌃" : "⌄";
    }

    document.getElementById("moreGamesBtn").onclick = () => {
      showAllGames = !showAllGames;
      renderGames();
    };

    renderGames();
    updateSelectedGameName();

    function switchServerTab(tab, btn) {
      serverTab = tab;
      document.querySelectorAll('.server-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderServers();
    }

    function pingClass(ms) {
      if (ms < 60) return "good";
      if (ms < 120) return "mid";
      return "bad";
    }

    function renderServerDots() {
      const dotsGroup = document.getElementById("serverDots");
      if (!dotsGroup) return;

      const center = 110;
      const best = servers.filter(s => s.ping !== null).sort((a, b) => a.ping - b.ping)[0];

      dotsGroup.innerHTML = servers.map(s => {
        const rad = s.angle * Math.PI / 180;
        const x = center + Math.cos(rad) * s.dist;
        const y = center + Math.sin(rad) * s.dist;
        const isBest = best && best.host === s.host && boosting === false;
        const cls = isBest ? "best" : (boosting ? "scanning-dot" : "auto");
        const r = isBest ? 6 : 4;

        return `
          <circle class="dot-halo ${cls}" cx="${x}" cy="${y}" r="${r * 2.2}"/>
          <circle class="server-dot ${cls}" cx="${x}" cy="${y}" r="${r}"/>
        `;
      }).join("");
    }

    function selectManualServer(host) {
      if (manualSelected === host) {
        manualSelected = null;
        localStorage.removeItem('nova_manual_selected');
        toast("انتخاب دستی لغو شد");
      } else {
        manualSelected = host;
        localStorage.setItem('nova_manual_selected', host);
        toast("سرور دستی انتخاب شد");
      }
      renderServers();
    }

    function renderServers() {
      const list = document.getElementById("serverList");
      const filtered = serverTab === 'auto' ? servers.filter(s => s.auto) : servers;

      if (filtered.length === 0) {
        list.innerHTML = '<div class="muted" style="text-align:center;padding:20px;">سروری موجود نیست</div>';
        return;
      }

      list.innerHTML = filtered.map(server => {
        const pingText = server.ping === null ? "..." : server.ping + " ms";
        const badgeClass = server.ping === null ? "" : pingClass(server.ping);
        const bestClass = currentBest && server.host === currentBest ? "best" : "";
        const manualClass = manualSelected === server.host ? "manual-selected" : "";
        const clickHandler = serverTab === 'manual' ? `onclick="selectManualServer('${server.host}')"` : "";

        return `
          <div class="server-row ${bestClass} ${manualClass}" ${clickHandler}>
            <div>
              <div class="server-name">${server.name}</div>
              <div class="server-host">${server.host}:${server.port} • ${server.auto ? "AUTO" : "MANUAL"}</div>
            </div>
            <div class="ping-badge ${badgeClass}">${pingText}</div>
          </div>
        `;
      }).join("");

      renderServerDots();
    }

    async function fakePing(server) {
      await new Promise(resolve => setTimeout(resolve, 200 + Math.random() * 600));

      let base = 110;
      if (server.host.includes("ir")) base = 22;
      if (server.host.includes("tr")) base = 72;
      if (server.host.includes("ae")) base = 58;
      if (server.host.includes("de")) base = 96;
      if (server.host.includes("sg")) base = 132;

      let gameOffset = 0;
      if (selectedGame) {
        const offsets = { mlbb: 5, codm: 10, df: 18, pubg: 8, ff: 6, fc: 12, ef: 14, hok: 7 };
        gameOffset = offsets[selectedGame] || 0;
      }

      return Math.max(14, Math.floor(base + gameOffset + Math.random() * 35));
    }

    async function refreshServers() {
      for (const server of servers) {
        server.ping = await fakePing(server);
        renderServers();
      }
    }

    document.getElementById("refreshServers").onclick = async () => {
      toast("Refreshing servers...");
      await refreshServers();
      toast("Servers updated");
    };

    renderServers();
    refreshServers();
    createRadarParticles();

    function renderHistory() {
      const el = document.getElementById("pingHistory");

      if (pingHistory.length === 0) {
        el.innerHTML = '<div class="muted" style="font-size:11px;">NO BOOST YET</div>';
        return;
      }

      el.innerHTML = pingHistory.map(p => {
        const height = Math.max(4, Math.min(50, 70 - p));
        return `<div class="bar" style="height:${height}px;"></div>`;
      }).join("");
    }

    renderHistory();

    function setRing(percent) {
      document.getElementById("ringProgress").style.strokeDashoffset =
        circumference - (circumference * percent / 100);
    }

    function countUpPing(el, target) {
      const unit = document.getElementById("pingUnit");
      if (unit) unit.style.display = 'inline';

      const start = performance.now();
      const duration = 900;

      function frame(now) {
        const progress = Math.min((now - start) / duration, 1);
        const value = Math.floor(progress * target);
        el.textContent = value;
        if (progress < 1) {
          requestAnimationFrame(frame);
        } else {
          el.textContent = target;
        }
      }

      requestAnimationFrame(frame);
    }

    document.getElementById("boostBtn").onclick = async function () {
      if (boosting) {
        stopBoost();
        return;
      }

      boosting = true;
      this.innerHTML = 'STOP BOOST<span class="btn-sub">توقف بوست</span>';
      document.getElementById("boostCard").classList.add("scanning");

      let progress = 0;
      boostTimer = setInterval(() => {
        progress = Math.min(90, progress + 2);
        setRing(progress);
      }, 60);

      let serversToTest = manualSelected
        ? servers.filter(s => s.host === manualSelected)
        : servers.filter(s => s.auto);

      if (serversToTest.length === 0) {
        serversToTest = servers.filter(s => s.auto);
      }

      for (const server of serversToTest) {
        server.ping = await fakePing(server);
        renderServers();
      }

      const best = serversToTest
        .filter(s => s.ping !== null)
        .sort((a, b) => a.ping - b.ping)[0];

      clearInterval(boostTimer);
      setRing(100);

      if (best) {
        currentBest = best.host;
        countUpPing(document.getElementById("pingValue"), best.ping);
        document.getElementById("serverValue").textContent = best.name.toUpperCase();
        document.getElementById("jitter").textContent =
          Math.max(1, Math.floor(best.ping * 0.07)) + " ms";
        document.getElementById("loss").textContent =
          (Math.random() * 0.7).toFixed(1) + "%";
        document.getElementById("route").textContent =
          best.host.split(".")[0].toUpperCase();

        pingHistory.push(best.ping);
        if (pingHistory.length > 10) pingHistory.shift();
        renderHistory();

        renderServers();
        toast("Best server found");
      } else {
        document.getElementById("pingValue").textContent = "--";
        document.getElementById("serverValue").textContent = "NO SERVER FOUND";
        toast("No server found");
      }
    };

    function stopBoost() {
      boosting = false;
      clearInterval(boostTimer);
      document.getElementById("boostCard").classList.remove("scanning");
      setRing(0);

      document.getElementById("pingValue").textContent = "--";
      const unit = document.getElementById("pingUnit");
      if (unit) unit.style.display = 'none';

      document.getElementById("serverValue").textContent = "SELECT A SERVER";
      document.getElementById("jitter").textContent = "--";
      document.getElementById("loss").textContent = "--";
      document.getElementById("route").textContent = "--";

      document.getElementById("boostBtn").innerHTML =
        'START BOOST<span class="btn-sub">شروع بوست</span>';

      currentBest = null;
      renderServers();
      toast("Boost stopped");
    }

    function showPage(id, btn) {
      document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
      document.getElementById(id).classList.add("active");
      document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
    }

    function updateStatus() {
      const el = document.getElementById("netStatus");

      if (navigator.onLine) {
        el.textContent = "ONLINE";
        el.classList.remove("offline");
      } else {
        el.textContent = "OFFLINE";
        el.classList.add("offline");
      }
    }

    window.addEventListener("online", updateStatus);
    window.addEventListener("offline", updateStatus);
    updateStatus();

    let toastTimer;
    function toast(message) {
      const el = document.getElementById("toast");
      el.textContent = message;
      el.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove("show"), 2600);
    }

    function setTheme(theme, silent = false) {
      document.body.dataset.theme = theme;
      localStorage.setItem("nova_theme", theme);

      document.querySelectorAll(".theme-btn").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.theme === theme);
      });

      if (!silent) {
        toast(theme === "white" ? "تم روشن فعال شد" : "تم نئون ترکیبی فعال شد");
      }
    }

    document.querySelectorAll(".theme-btn").forEach(btn => {
      btn.onclick = () => setTheme(btn.dataset.theme);
    });

    setTheme(localStorage.getItem("nova_theme") || "neon", true);

    document.getElementById("saveProfile").onclick = () => {
      const data = {
        username: document.getElementById("username").value,
        mobile: document.getElementById("mobile").value,
        email: document.getElementById("email").value
      };

      localStorage.setItem("nova_profile", JSON.stringify(data));
      toast("پروفایل ذخیره شد");
    };

    function loadProfile() {
      const data = JSON.parse(localStorage.getItem("nova_profile") || "{}");

      if (data.username) document.getElementById("username").value = data.username;
      if (data.mobile) document.getElementById("mobile").value = data.mobile;
      if (data.email) document.getElementById("email").value = data.email;
    }

    loadProfile();

    document.querySelectorAll(".plan").forEach(plan => {
      plan.onclick = () => {
        document.querySelectorAll(".plan").forEach(p => p.classList.remove("active"));
        plan.classList.add("active");
        toast(plan.querySelector("b").textContent + " انتخاب شد");
      };
    });

    document.getElementById("buyBtn").onclick = () => {
      toast("درگاه پرداخت به زودی فعال می‌شود");
    };

    const notifySwitch = document.getElementById("notifySwitch");
    notifySwitch.checked = localStorage.getItem("nova_notify") !== "0";

    notifySwitch.onchange = () => {
      localStorage.setItem("nova_notify", notifySwitch.checked ? "1" : "0");
      toast(notifySwitch.checked ? "اعلان بروزرسانی روشن شد" : "اعلان بروزرسانی خاموش شد");
    };
  </script>

</body>
</html>
