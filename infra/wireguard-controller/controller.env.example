# Copy to /etc/nova-controller/controller.env and replace every placeholder.
PORT=8080
NOVA_CONTROLLER_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
NOVA_SERVER_ID=CHANGE_ME_SUPABASE_VPN_SERVER_UUID
WG_INTERFACE=wg0
WG_NETWORK=10.66.0.0/24
WG_SERVER_ADDRESS=10.66.0.1/24
WG_SERVER_PUBLIC_KEY=CHANGE_ME_WIREGUARD_SERVER_PUBLIC_KEY
WG_ENDPOINT_HOST=CHANGE_ME_PUBLIC_IP_OR_DOMAIN
WG_ENDPOINT_PORT=51820
WG_DNS=1.1.1.1,1.0.0.1
WG_PERSISTENT_KEEPALIVE=25
WG_MTU=1280
NOVA_STATE_FILE=/var/lib/nova-wg/peers.json
