[Unit]
Description=NOVA WireGuard Controller
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/nova-controller/controller.env
ExecStart=/usr/bin/node /opt/nova-wireguard-controller/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nova-wg

[Install]
WantedBy=multi-user.target
